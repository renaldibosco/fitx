<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="14dp">
        <TextView
            android:id="@+id/w_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#C8F135"
            android:textSize="34sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WK STREAK"
            android:textColor="#A3AAB5"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NrXFitz · NEXT UP"
            android:textColor="#C8F135"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Open NrXFitz to start"
            android:textColor="#F2F4F7"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 0 this week"
            android:textColor="#A3AAB5"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
